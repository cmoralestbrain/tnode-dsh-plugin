{
  "name": "@tnode/dsh-plugin",
  "version": "0.9.0",
  "type": "module",
  "description": "TNode plugin for DeepSeek Harness: host bridge + owner chat panel",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/a2a-tool.js",
    "lib/cli/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmoralestbrain/tnode-dsh-plugin.git"
  },
  "homepage": "https://github.com/cmoralestbrain/tnode-dsh-plugin",
  "license": "MIT"
}
